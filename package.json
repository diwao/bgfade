{
  "name": "bgfade",
  "version": "1.1.0",
  "description": "JavaScript library for switch DOM elements.",
  "type": "module",
  "main": "./dist/bgfade.cjs",
  "module": "./dist/bgfade.js",
  "types": "./dist/bgfade.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/bgfade.d.ts",
        "default": "./dist/bgfade.js"
      },
      "require": {
        "types": "./dist/bgfade.d.cts",
        "default": "./dist/bgfade.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/write-cjs-wrapper.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:exports": "tsc test/types/cjs-require.cts test/types/esm-import.mts --ignoreConfig --module Node16 --moduleResolution node16 --target es2020 --strict --skipLibCheck --noEmit --ignoreDeprecations 6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diwao/bgfade.git"
  },
  "keywords": [
    "front-end",
    "frontend",
    "CSS"
  ],
  "author": "Daisuke Iwao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/diwao/bgfade/issues"
  },
  "homepage": "https://bgfade.site",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}

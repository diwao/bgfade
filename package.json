{
  "name": "bgfade",
  "version": "1.1.0",
  "description": "JavaScript library for switch DOM elements.",
  "type": "module",
  "main": "./dist/bgfade.cjs",
  "module": "./dist/bgfade.js",
  "types": "./dist/bgfade.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bgfade.d.ts",
      "import": "./dist/bgfade.js",
      "require": "./dist/bgfade.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diwao/bgfade.git"
  },
  "keywords": [
    "front-end",
    "frontend",
    "CSS"
  ],
  "author": "Daisuke Iwao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/diwao/bgfade/issues"
  },
  "homepage": "https://bgfade.site",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
